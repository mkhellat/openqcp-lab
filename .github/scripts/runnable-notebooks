#!/usr/bin/env python3
"""Print the tutorial notebooks CI can execute, one path per line.

A notebook whose code cells use classiq is left out: Classiq
synthesis and execution run on Classiq's cloud and need a logged-in
account, which CI does not have. Those notebooks still get the
structural check in preflight. Every other tracked notebook under
tutorials/ is listed, so a new notebook is executed by default.
"""

import json
import re
import subprocess
import sys

CLOUD = re.compile(r"\bclassiq\b")


def code_of(path):
    with open(path, encoding="utf-8") as fh:
        nb = json.load(fh)
    return "\n".join(
        "".join(cell["source"])
        for cell in nb["cells"]
        if cell["cell_type"] == "code"
    )


def main():
    tracked = subprocess.run(
        ["git", "ls-files", "-z", "--", "tutorials/*.ipynb"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.split("\0")
    for path in sorted(p for p in tracked if p):
        if CLOUD.search(code_of(path)):
            print(f"skip (Classiq cloud): {path}", file=sys.stderr)
        else:
            print(path)


if __name__ == "__main__":
    main()
