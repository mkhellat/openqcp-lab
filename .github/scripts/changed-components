#!/usr/bin/env bash
# Decide which CI components a change touches. Prints key=value lines
# for $GITHUB_OUTPUT (or the terminal when run locally):
#
#   .github/scripts/changed-components <base-ref> <head-ref>
#   .github/scripts/changed-components --all
#
# --all (scheduled and manual runs) selects every component. A change
# to the CI itself also selects every component, so the CI is tested
# by its own pull request.
set -euo pipefail

paulikit=false
trotterkit=false
notebooks=false

if [ "${1:-}" = "--all" ]; then
    paulikit=true
    trotterkit=true
    notebooks=true
elif [ $# -eq 2 ]; then
    base=$(git merge-base "$1" "$2")
    while IFS= read -r f; do
        case "$f" in
            .github/workflows/ci.yml|.github/scripts/*)
                paulikit=true
                trotterkit=true
                notebooks=true ;;
            tools/paulikit/*) paulikit=true ;;
            tools/trotterkit/*)
                # The arbitrary-N notebook evolves its state with trotterkit.
                trotterkit=true
                notebooks=true ;;
            tutorials/*|requirements.txt) notebooks=true ;;
        esac
    done < <(git diff --name-only "$base" "$2" --)
else
    echo "usage: $0 <base-ref> <head-ref> | --all" >&2
    exit 2
fi

any=false
if [ "$paulikit$trotterkit$notebooks" != falsefalsefalse ]; then
    any=true
fi
echo "paulikit=$paulikit"
echo "trotterkit=$trotterkit"
echo "notebooks=$notebooks"
echo "any=$any"
