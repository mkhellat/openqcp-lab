#!/usr/bin/env bash
# Off-CPU (blocked) time capture: w2_c1 vs w8_c4, N=150, chunk_size=2.
#
# WHY THIS INSTRUMENT, AND NOT ANOTHER PERF STAT PASS.
# The recorded perf stat data (bandwidth_hypothesis_results.jsonl,
# n=5/condition) already establishes that between w2_c1 and w8_c4:
#     wall-clock   22.068s -> 24.801s   (+2.73s, w8_c4 SLOWER)
#     CPU-seconds    59.43 ->   57.76   (essentially equal)
#     instructions  236.4G ->  236.5G   (0.04% apart)
#     IPC             1.42 ->    1.51   (no extra stalling)
#     cache-miss%     9.37 ->    9.18   (no extra cache pressure)
# Same work, same efficiency, same cache behavior - and 2.73s more
# wall-clock. That time is therefore NOT on-CPU. `perf stat` counts
# only on-CPU events and by construction cannot see it; neither can
# perf_counter() timers around drain-loop nodes (they measure on-CPU
# work too, and its total is already known to be equal). `perf sched`
# records scheduler switch/wakeup events, which is the one available
# instrument that measures blocked time directly.
#
# FALSIFIABLE PREDICTIONS, STATED BEFORE THE RUN (per this phase's
# standing rule that a hypothesis must be able to fail):
#   H1  w8_c4's summed off-CPU/blocked time exceeds w2_c1's by roughly
#       the 2.73s wall-clock gap, scaled by how many threads block
#       concurrently. If the two conditions show SIMILAR blocked time,
#       H1 is FALSE and the off-CPU explanation is dead - the gap
#       would then have to be startup/teardown or measurement artifact.
#   H2  The blocking is concentrated in the pool's IPC path (the main
#       drain process waiting on result-queue reads, and/or workers
#       waiting on queue writes), NOT in involuntary preemption. If
#       `perf sched latency` instead shows the dominant cost as
#       involuntary switches spread evenly across workers, the cause
#       is CPU oversubscription, not the drain loop, and the whole
#       drain-loop framing needs revisiting.
#
# Must run as root: perf_event_paranoid=2 on this machine forbids
# unprivileged scheduler-event collection (checked directly). Same
# constraint and same run-it-yourself pattern as
# `code_specificity_capture` - the agent cannot invoke this.
#
#   sudo ./sched_offcpu_capture
#
# Foreground-only, one condition at a time, thermal cooldown before
# every timed run - the execution discipline established after
# concurrent background measurement jobs contaminated an earlier
# sweep in this same investigation.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "must run as root (sudo ./sched_offcpu_capture)" >&2
    exit 1
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

PYTHON=/home/desadm/.venvs/paulikit/bin/python
TARGET="$DIR/full_matrix_target.py"
CHUNK_SIZE=2
COOLDOWN_TARGET_C=55
COOLDOWN_TIMEOUT_S=180
TEMP_PATH=/sys/class/thermal/thermal_zone7/temp

if [ ! -x "$PYTHON" ]; then
    echo "venv python not found at $PYTHON" >&2
    exit 1
fi
if [ ! -f "$TARGET" ]; then
    echo "target not found at $TARGET" >&2
    exit 1
fi

cooldown() {
    local start now temp
    start=$(date +%s)
    while true; do
        temp=$(($(cat "$TEMP_PATH" 2>/dev/null || echo 0) / 1000))
        if [ "$temp" -le "$COOLDOWN_TARGET_C" ]; then
            echo "  cooled to ${temp}C"
            return
        fi
        now=$(date +%s)
        if [ $((now - start)) -gt "$COOLDOWN_TIMEOUT_S" ]; then
            echo "  cooldown timed out at ${temp}C (proceeding, logged)"
            return
        fi
        sleep 2
    done
}

# Guard against the contamination failure mode that invalidated an
# earlier sweep in this phase: refuse to start if another measurement
# process is already running.
running=$(pgrep -fc "full_matrix_target.py" || true)
if [ "$running" -gt 0 ]; then
    echo "another full_matrix_target.py is running - refusing to start" >&2
    echo "(concurrent measurement jobs invalidated an earlier sweep)" >&2
    exit 1
fi

# Turn a raw .data into the readable latency/summary report.
#
# NOTE on `set -euo pipefail` + `head`: piping perf into `head -N`
# makes `head` close the pipe early, perf dies on SIGPIPE, and
# `pipefail` then aborts the whole script - which on the FIRST run of
# this script silently truncated the latency table mid-row AND skipped
# the entire w8_c4 condition. Post-processing therefore runs WITHOUT
# head/tail truncation and WITHOUT pipefail, writing complete output;
# trim at read time instead.
postprocess() {
    local condition="$1" data="$2" out="$3" temp_before="$4" temp_after="$5"
    (
        set +e
        set +o pipefail
        echo "condition=$condition chunk_size=$CHUNK_SIZE"
        echo "temp_before=${temp_before}C temp_after=${temp_after}C"
        echo
        echo "########## perf sched latency (per-thread blocked time) ##########"
        # Sorted by max delay; this is the table that answers H1/H2.
        perf sched latency -i "$data" --sort max 2>&1
        lat_rc=$?
        echo "[latency exit=$lat_rc]"
        echo
        echo "########## perf sched timehist --summary ##########"
        # `--summary` (-s), NOT `--summary-only`: the latter does not
        # exist on this machine's perf (7.2.3-1) - verified against
        # `perf sched timehist --help` before shipping this script,
        # after a `perf script --fields sym` assumption silently
        # produced garbage earlier in this same investigation.
        #
        # Memory-hungry on a large .data file, so it runs LAST and
        # guarded: if it fails, the latency table above - the table
        # that actually answers H1/H2 - is already written.
        perf sched timehist -i "$data" --summary 2>&1
        echo "[timehist exit=$?]"
    ) > "$out" 2>&1

    chown --reference="$DIR" "$out" 2>/dev/null || true
    echo "  wrote $out ($(du -h "$data" | cut -f1) raw)"
    echo
}

capture() {
    local condition="$1"
    local data="$DIR/sched_${condition}.data"
    local out="$DIR/sched_${condition}.txt"

    echo "=== $condition (chunk_size=$CHUNK_SIZE) ==="

    # Resume-skip: a capture that already produced a .data file is not
    # repeated (same resume discipline as full_optimum_sweep.py). Only
    # the cheap post-processing below re-runs. Delete the .data to
    # force a fresh capture.
    if [ -s "$data" ]; then
        echo "  $data already exists - reusing it, skipping capture"
        chown --reference="$DIR" "$data" 2>/dev/null || true
        postprocess "$condition" "$data" "$out" "reused" "reused"
        return
    fi

    cooldown
    local temp_before
    temp_before=$(($(cat "$TEMP_PATH" 2>/dev/null || echo 0) / 1000))

    # -g for call graphs so a blocked stack can be attributed to a
    # call site, not just a thread. Whole-run capture (not a sampled
    # window) so summed blocked time is complete rather than an
    # extrapolation from a snapshot - the small-n caveat that limited
    # the earlier py-spy evidence (3 stack dumps) does not apply here.
    perf sched record -g -o "$data" -- \
        env OPENBLAS_NUM_THREADS=1 "$PYTHON" "$TARGET" "$condition" "$CHUNK_SIZE" \
        2>&1 | tail -5

    local temp_after
    temp_after=$(($(cat "$TEMP_PATH" 2>/dev/null || echo 0) / 1000))

    # Hand ownership back IMMEDIATELY, before any post-processing:
    # `perf record` writes .data as root:root 0600, and if a later
    # step in this function fails, an un-chowned .data cannot be
    # re-analyzed unprivileged afterwards (exactly what happened on
    # the first run of this script - the capture itself was fine and
    # its 178MB of data was briefly unusable for no good reason).
    chown --reference="$DIR" "$data" 2>/dev/null || true

    postprocess "$condition" "$data" "$out" "$temp_before" "$temp_after"
}

echo "NOTE: perf sched records EVERY context switch - the .data files"
echo "are large and are gitignored, like the existing perf_*.perf.data."
echo

capture w2_c1
capture w8_c4

echo "=== done ==="
echo "Compare with:"
echo "  grep -A25 'sched latency' sched_w2_c1.txt sched_w8_c4.txt"
