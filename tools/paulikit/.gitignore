.venv/
__pycache__/
*.pyc
build/
*.egg-info/
.pytest_cache/

# Generated by ./configure — see Makefile.in for the source template.
Makefile
config.log
config.status

# Raw sweep output — written incrementally by profiling/phase13's
# background measurement drivers. Most of these are throwaway scratch
# runs (findings .md files are the deliverable, not raw scratch data),
# but full_optimum_sweep_results.jsonl is the actual dataset behind
# the publication-grade sweep and is committed deliberately below.
profiling/phase13/*_results.jsonl
!profiling/phase13/full_optimum_sweep_results.jsonl

# Raw perf record capture (hundreds of MB, machine/run-specific binary
# sample data) — the post-processed perf report/annotate .txt outputs
# and the findings .md are the deliverable, not the raw .perf.data.
profiling/phase13/*.perf.data

# Raw `perf sched record` scheduler-event capture (sched_offcpu_capture)
# - every context switch over a ~25s run, larger than the cycles-event
# .perf.data above. The post-processed sched_*.txt latency tables are
# the deliverable and ARE committed.
profiling/phase13/sched_*.data

# Full (non-truncated) perf annotate dumps - mostly 0%-sample
# disassembly lines, several MB each; regeneratable from perf_deep_dive
# against the (gitignored) .perf.data. The full *.report.full.txt and
# *.symbol_histogram.txt (much smaller, and where the actual finding
# lives) are committed.
profiling/phase13/*.annotate.full.txt

# uv-generated lockfile. This project builds through its own
# configure/Makefile (meson-python underneath), not uv, so the lock
# is a local convenience artifact rather than part of the build
# contract - and pinning it would conflict with the prebuilt-wheel
# model PLAN.md targets.
uv.lock
