option(
  'native',
  type: 'feature',
  value: 'auto',
  description: 'Build the optional compiled pauli_label fast path (Cython + C + oneTBB). ' +
               '"auto" builds it if Cython and oneTBB are found, otherwise falls back to ' +
               'pure Python silently at build time (fwht.py warns at import time if the ' +
               'compiled extension is unavailable). Pass -Dnative=disabled to force pure-' +
               'Python-only, or -Dnative=enabled to fail the build if it cannot be built.',
)
