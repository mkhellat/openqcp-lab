option(
  'native',
  type: 'feature',
  value: 'auto',
  description: 'Build the optional compiled pauli_label fast path (Cython + C + oneTBB). ' +
               '"auto" builds it if Cython and oneTBB are found, otherwise falls back to ' +
               'pure Python silently at build time (fwht.py warns at import time if the ' +
               'compiled extension is unavailable). Pass -Dnative=disabled to force pure-' +
               'Python-only, or -Dnative=enabled to fail the build if it cannot be built.',
)

option(
  'cache_probe',
  type: 'feature',
  value: 'auto',
  description: 'Build the optional compiled cache-latency probe (Cython + C, PLAN.md ' +
               'Phase 12). Independent of the "native" option above - has no oneTBB ' +
               'dependency, only needs Cython >= 3.0. "auto" builds it if Cython is found, ' +
               'otherwise falls back to declared-size cache detection at runtime with a ' +
               'visible warning. Pass -Dcache_probe=disabled to force the fallback, or ' +
               '-Dcache_probe=enabled to fail the build if it cannot be built.',
)

option(
  'wht_kernel',
  type: 'feature',
  value: 'auto',
  description: 'Build the optional compiled Walsh-Hadamard butterfly kernel (Cython + C, ' +
               'PLAN.md Phase 14). Independent of the "native" option - needs neither C++ ' +
               'nor oneTBB, only a C compiler and Cython >= 3.0, so it can be built on ' +
               'machines where pauli_label_native cannot. This carries the transform ' +
               'itself (69.5% of per-chunk time), so it is the one worth having. "auto" ' +
               'builds it if Cython is found, otherwise falls back to the pure-Python ' +
               'butterfly. Pass -Dwht_kernel=disabled to force the fallback, or ' +
               '-Dwht_kernel=enabled to fail the build if it cannot be built.',
)
