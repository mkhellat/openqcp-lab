#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Mohammadreza Khellat <mkhellat@beavernets.com>
#
# trotterkit configure: create or reuse a Python venv, check the
# toolchain, and write Makefile from Makefile.in.
#
# Usage: ./configure [--venv=PATH] [--python=PATH]
set -eu

venv="${HOME}/.venvs/trotterkit"
python_bin=""

for arg in "$@"; do
    case "$arg" in
        --venv=*) venv="${arg#--venv=}" ;;
        --python=*) python_bin="${arg#--python=}" ;;
        -h|--help)
            sed -n '5,8p' "$0"
            exit 0 ;;
        *)
            echo "configure: unknown option: $arg" >&2
            exit 1 ;;
    esac
done

if [ -z "$python_bin" ]; then
    for cand in python3.13 python3.12 python3.11 python3.10 python3
    do
        if command -v "$cand" >/dev/null 2>&1; then
            python_bin=$(command -v "$cand")
            break
        fi
    done
fi
if [ -z "$python_bin" ]; then
    echo "configure: no python3 interpreter found" >&2
    exit 1
fi
if ! "$python_bin" -c \
    'import sys; sys.exit(sys.version_info < (3, 10))'; then
    echo "configure: $python_bin is older than Python 3.10" >&2
    exit 1
fi

for tool in cc meson ninja; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "configure: required tool not found: $tool" >&2
        exit 1
    fi
done
meson_bin=$(command -v meson)

if [ ! -x "$venv/bin/python" ]; then
    "$python_bin" -m venv "$venv"
fi

sed -e "s|@VENV@|$venv|g" -e "s|@MESON@|$meson_bin|g" \
    Makefile.in > Makefile
echo "configure: venv $venv"
echo "configure: next run 'make build' then 'make check'"
