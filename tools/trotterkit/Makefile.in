# Generated from Makefile.in by ./configure; edit Makefile.in.
# Portable across GNU and POSIX make: no GNU-only constructs.

VENV   = @VENV@
PYTHON = $(VENV)/bin/python
PIP    = $(PYTHON) -m pip
PYTEST = $(VENV)/bin/pytest
MESON  = @MESON@

all: build

build:
	test -f builddir/build.ninja || $(MESON) setup builddir
	$(MESON) compile -C builddir
	mkdir -p src/trotterkit/_lib
	cp builddir/libtrotterkit_c.so src/trotterkit/_lib/
	cp builddir/trotterkit-c src/trotterkit/_lib/
	$(PIP) install -e '.[test]'

check: build
	shellcheck -s sh configure
	$(PYTEST)

test: check

clean:
	rm -rf builddir src/trotterkit/_lib

.PHONY: all build check test clean
