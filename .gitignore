# Jupyter
**/.ipynb_checkpoints/
*.ipynb_save
*.ipynb_checkpoints

# Scratch/test notebooks (keep locally but don't version control)
**/test.ipynb
**/Untitled.ipynb

# Local investigation/reference material (e.g. library-internals
# inspection) that isn't part of the polished tutorials
notes/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Python packaging (paulikit and any future packages)
.pytest_cache/
*.egg-info/
build/
dist/
*.egg

# Compiled C-extension binding artifacts (paulikit Phase 3, tools/paulikit/bindings/)
# - source .pyx/.c/.py hand-written files are versioned; Cython/CFFI-
#   generated .c, .o, and compiled shared objects are not.
*.so
*.pyd
*.o
tools/paulikit/bindings/cython/pauli_label_cy.c
tools/paulikit/bindings/cffi/_pauli_label_cffi.c

# Sphinx build output (paulikit and any future packages' docs/)
_build/

# Virtual environments
.env
.venv
venv/
env/

# Editor / OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Local data / cache
*.log
*.tmp
.cache/

# Generated by ./bootstrap
config.mk

# Claude Code local settings
.claude/settings.local.json
